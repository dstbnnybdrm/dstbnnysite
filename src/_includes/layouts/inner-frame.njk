{% extends "layouts/base.njk" %}
{% set stylesheet = "inner-frame" %}

{% block meta %}
  <base target="_parent" />
{% endblock %}

{% block content %}
  <div class="[ inner-frame ] [ flow box ]">
    <main class="prose flow">{{ content | safe }}</main>

    <noscript>
      <div class="[ inner-frame__footer ] [ box ] [ mt-s text-center ]">
        <small>want to get <a href="/hub.html">outside of frame</a>?</small>
      </div>
    </noscript>

    <footer class="[ inner-frame__footer ] [ box ]" id="inner-frame-footer" hidden>
      <nav>
        <ul class="cluster" role="list" style="justify-content:center; row-gap:0;">
          <li class="board-list">
            <a href="/home.html" {% if "home" in page.url %}aria-current="page"{% endif %}>home</a>
          </li>
          <li>
            <ul class="board-list" role="list">
              <li><a href="/about.html">about</a></li>
              <li>
                <a href="/projects/" target="_self" {% if "projects" in page.url %}aria-current="page"{% endif %}
                  >projects</a
                >
              </li>
              <li><a href="/blog/">blog</a></li>
              <li>
                <a href="/shrines/" target="_self" {% if "shrines" in page.url %}aria-current="page"{% endif %}
                  >shrines</a
                >
              </li>
            </ul>
          </li>

          <li>
            <ul class="board-list" role="list">
              <li>
                <a href="/resources.html" target="_self" {% if "resources" in page.url %}aria-current="page"{% endif %}
                  >resources</a
                >
              </li>
              <li>
                <a href="/links.html" target="_self" {% if "links" in page.url %}aria-current="page"{% endif %}
                  >links</a
                >
              </li>
              <li><a href="/guestbook.html">guestbook</a></li>
            </ul>
          </li>
        </ul>

        <div class="text-center">
          <small>want to get <a href="/hub.html">outside of frame</a>?</small>
        </div>
      </nav>
    </footer>
  </div>
{% endblock %}
