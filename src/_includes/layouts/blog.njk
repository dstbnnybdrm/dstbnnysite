{% extends "layouts/base.njk" %}

{% block content %}
  <div class="[ has-sticky-footer ] [ gap-l ]">
    <div class="flow">
      <header class="flow center-x wrapper">
        <pre role="img" aria-label="a row of books" title="a row of books">
       .--.       .---.   
   .---|__|       |~~~|   
.--|===|--|_      |~~~|--.
|  |===|  |'\     |   |--|
|%%|   |  |.'\    |   |  |
|%%|   |  |\.'\   |   |  |
|  |   |  | \  \  |   |  |
|  |   |__|  \.'\ |~~~|__|
|  |===|--|   \.'\|~~~|--|</pre
        >

        <nav class="blog-nav" aria-labelledby="nav-1">
          <h2 class="visually-hidden" id="nav-1">navigation</h2>

          {% include "partials/skip-link.njk" %}

          <ul class="pipe-list" role="list">
            <li><a href="/hub.html">main site</a></li>
            <li><a href="/blog/" {% if "/blog/" == page.url %}aria-current="page"{% endif %}>home</a></li>
            <li>
              <a href="/blog/archive.html" {% if "archive" in page.url %}aria-current="page"{% endif %}>archive</a>
            </li>
          </ul>
        </nav>
      </header>

      {{ content | safe }}
    </div>

    <footer class="[ box flow wrapper ] [ flow-space-3xs ]">{% include "partials/footer.njk" %}</footer>
  </div>
{% endblock content %}
