---
title: "archive"
layout: "layouts/blog-home.njk"
---

<h1>{{ title }}</h1>

<nav>
  <ul>
    {% for post in collections.post | reverse %}
      <li>
        <span class="font-mono">{{ post.date | ISODate }}</span>:
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
